{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "strict": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleDetection": "legacy"
  },
  "include": [
    "scripts/*.ts",
    "docs/javascripts/*.ts"
  ]
}
